<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:centerColor="#0C7468"
                android:endColor="#05465A"
                android:startColor="#3F9B3A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.08"
                android:centerY="1.0"
                android:endColor="#00D7E83C"
                android:gradientRadius="75%p"
                android:startColor="#B3E3EE3E"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.9"
                android:centerY="0.0"
                android:endColor="#0032D2E8"
                android:gradientRadius="60%p"
                android:startColor="#5532D2E8"
                android:type="radial" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_streaks" />
</layer-list>
