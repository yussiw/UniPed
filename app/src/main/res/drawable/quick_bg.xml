<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#445AA8E0"
                        android:startColor="#99CDEBFF" />
                    <stroke android:width="1dp" android:color="#E6FFFFFF" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item
                android:bottom="18dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#14FFFFFF"
                        android:startColor="#66FFFFFF" />
                    <corners android:topLeftRadius="3dp" android:topRightRadius="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#885A9FD8" />
            <stroke android:width="1dp" android:color="#E6FFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#10FFFFFF"
                android:startColor="#28FFFFFF" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
