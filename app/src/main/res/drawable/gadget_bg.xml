<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#CC070B0D"
                android:startColor="#CC2A3A40" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:bottom="46dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#06FFFFFF"
                android:startColor="#30FFFFFF" />
            <corners android:topLeftRadius="9dp" android:topRightRadius="9dp" />
        </shape>
    </item>
</layer-list>
