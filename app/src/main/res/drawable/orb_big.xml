<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#FF0A2A55"
                android:startColor="#FFBFE6FF" />
            <stroke android:width="2dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#FF2D8CE0"
                android:centerX="0.5"
                android:centerY="0.85"
                android:endColor="#FF0B4AA8"
                android:gradientRadius="60%p"
                android:startColor="#FFB4F0FF"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:bottom="40dp"
        android:left="12dp"
        android:right="12dp"
        android:top="6dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#10FFFFFF"
                android:startColor="#CCFFFFFF" />
        </shape>
    </item>
</layer-list>
