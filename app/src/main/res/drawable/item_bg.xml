<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#4F6FB9EC"
                        android:startColor="#99DCF0FF" />
                    <stroke android:width="1dp" android:color="#E6FFFFFF" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item
                android:bottom="34dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#12FFFFFF"
                        android:startColor="#55FFFFFF" />
                    <corners android:topLeftRadius="5dp" android:topRightRadius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#665CA8E8" />
            <stroke android:width="1dp" android:color="#CCFFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
