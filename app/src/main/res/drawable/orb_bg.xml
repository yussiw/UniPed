<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:centerX="0.5"
                        android:centerY="0.85"
                        android:gradientRadius="30dp"
                        android:startColor="#B5E8FF"
                        android:endColor="#1068C8"
                        android:type="radial" />
                    <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="22dp"
                android:left="6dp"
                android:right="6dp"
                android:top="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#E6FFFFFF"
                        android:endColor="#20FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:centerX="0.5"
                        android:centerY="0.85"
                        android:gradientRadius="30dp"
                        android:startColor="#7FD6FF"
                        android:endColor="#0A4A9C"
                        android:type="radial" />
                    <stroke android:width="1.5dp" android:color="#CCFFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="22dp"
                android:left="6dp"
                android:right="6dp"
                android:top="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#CCFFFFFF"
                        android:endColor="#10FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
