<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aero">

<LinearLayout
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/titleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="44dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:text="UniPed"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="12dp"
                android:layout_weight="1"
                android:background="@drawable/glass_panel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="2dp"
                    android:weightSum="2">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/gloss_top" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="16dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Barra lateral com gadgets, como no Vista -->
        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="112dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="top|center_horizontal"
            android:orientation="vertical">

            <br.uniped.launcher.ClockView
                android:layout_width="76dp"
                android:layout_height="76dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/gadget_cal"
                android:gravity="center"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="MMM yyyy"
                    android:format24Hour="MMM yyyy"
                    android:shadowColor="#66000000"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:format12Hour="d"
                    android:format24Hour="d"
                    android:shadowColor="#66000000"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE"
                    android:format24Hour="EEEE"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/gadget_bg"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sistema"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/netStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:drawableStart="@drawable/ic_wifi_s"
                    android:drawablePadding="4dp"
                    android:text="Rede"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/diskStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/ramStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/taskbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/taskbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/orb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/orb_bg"
            android:clickable="true"
            android:contentDescription="Configurações"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_orb_glyph" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/qWifi"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:contentDescription="Wi-Fi e rede"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_wifi" />
            <ImageView
                android:id="@+id/qBt"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:contentDescription="Bluetooth"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_bluetooth" />
            <ImageView
                android:id="@+id/qSound"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:contentDescription="Som"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_volume" />
            <ImageView
                android:id="@+id/qDisplay"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:contentDescription="Tela"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_display" />
            <ImageView
                android:id="@+id/qStorage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:contentDescription="Armazenamento"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_storage" />
            <ImageView
                android:id="@+id/qApps"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:contentDescription="Gerenciar apps"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_apps" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, d MMM"
                android:format24Hour="EEE, d MMM"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<FrameLayout
    android:id="@+id/introLayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aero"
    android:clickable="true">

    <LinearLayout
        android:id="@+id/introGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/introOrb"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/orb_big"
            android:padding="22dp"
            android:src="@drawable/ic_orb_glyph" />

        <TextView
            android:id="@+id/introText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.12"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="5"
            android:text="UniPed"
            android:textColor="#FFFFFF"
            android:textSize="32sp" />
    </LinearLayout>
</FrameLayout>
</FrameLayout>
