<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerX="0.5"
                android:centerY="0.85"
                android:gradientRadius="70dp"
                android:startColor="#9FE2FF"
                android:endColor="#0A4A9C"
                android:type="radial" />
            <stroke android:width="2dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="44dp"
        android:left="12dp"
        android:right="12dp"
        android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#CCFFFFFF"
                android:endColor="#10FFFFFF" />
        </shape>
    </item>
</layer-list>
