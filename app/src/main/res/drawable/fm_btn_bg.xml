<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/item_bg" android:state_focused="true" />
    <item android:drawable="@drawable/item_bg" android:state_pressed="true" />
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#18FFFFFF"
                android:startColor="#44FFFFFF" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
