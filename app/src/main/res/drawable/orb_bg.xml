<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#FF0B3A78"
                        android:startColor="#FFBFE6FF" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:centerColor="#FF3C9CF0"
                        android:centerX="0.5"
                        android:centerY="0.85"
                        android:endColor="#FF0B4AA8"
                        android:gradientRadius="60%p"
                        android:startColor="#FFB4F0FF"
                        android:type="radial" />
                </shape>
            </item>
            <item
                android:bottom="20dp"
                android:left="6dp"
                android:right="6dp"
                android:top="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#10FFFFFF"
                        android:startColor="#CCFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#FF0A2A55"
                        android:startColor="#FF9CD2F0" />
                    <stroke android:width="1dp" android:color="#FF0A1E38" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:centerColor="#FF2D8CE0"
                        android:centerX="0.5"
                        android:centerY="0.85"
                        android:endColor="#FF0B4AA8"
                        android:gradientRadius="60%p"
                        android:startColor="#FF8FE3FF"
                        android:type="radial" />
                </shape>
            </item>
            <item
                android:bottom="20dp"
                android:left="6dp"
                android:right="6dp"
                android:top="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#0AFFFFFF"
                        android:startColor="#B3FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
